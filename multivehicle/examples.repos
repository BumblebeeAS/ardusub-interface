# examples.repos
#
# Every dependency of the multivehicle project: the simulator (worlds, models,
# gz plugins), the autopilot bridges, and the mission/control stack.

repositories:
  ardupilot_gazebo:
    type: git
    url: https://github.com/ArduPilot/ardupilot_gazebo.git
  Micro-XRCE-DDS-Agent:
    type: git
    url: https://github.com/eProsima/Micro-XRCE-DDS-Agent.git
    version: v2.4.3
    depth: 1
  px4_msgs:
    type: git
    url: https://github.com/PX4/px4_msgs.git
    version: release/1.16
  gz_led_plugin:
    type: git
    url: https://github.com/BumblebeeAS/bb_led_plugin.git
    version: main
  vehicular_distance_plugin:
    type: git
    url: https://github.com/BumblebeeAS/vehicular_distance_plugin.git
    version: master
  bb_robotx_dashboard:
    type: git
    url: https://github.com/BumblebeeAS/bb_robotx_dashboard.git
  bb_worlds:
    type: git
    url: https://github.com/BumblebeeAS/bb_worlds.git
    version: multivehicle_sim
  bb_msgs:
    type: git
    url: https://github.com/BumblebeeAS/bb_msgs.git
    version: multivehicle_sim
  uav2_offboard:
    type: git
    url: https://github.com/BumblebeeAS/uav2_offboard.git
  mission_planner_release:
    type: git
    url: https://github.com/BumblebeeAS/mission_planner_release.git
    version: main
  frames:
    type: git
    url: https://github.com/BumblebeeAS/frames.git
    version: humble
